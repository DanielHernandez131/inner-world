{
  "$defs": {
    "CharacterVoice": {
      "additionalProperties": false,
      "properties": {
        "emotion": {
          "$ref": "#/$defs/Emotion"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "emotion",
        "text"
      ],
      "title": "CharacterVoice",
      "type": "object"
    },
    "ClarificationQuestion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "options": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 2,
          "title": "Options",
          "type": "array"
        }
      },
      "required": [
        "id",
        "text",
        "options"
      ],
      "title": "ClarificationQuestion",
      "type": "object"
    },
    "ClarificationResult": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "clarification",
          "title": "Status",
          "type": "string"
        },
        "question": {
          "$ref": "#/$defs/ClarificationQuestion"
        }
      },
      "required": [
        "status",
        "question"
      ],
      "title": "ClarificationResult",
      "type": "object"
    },
    "CompleteResult": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "complete",
          "title": "Status",
          "type": "string"
        },
        "analysis": {
          "$ref": "#/$defs/EmotionalAnalysis"
        }
      },
      "required": [
        "status",
        "analysis"
      ],
      "title": "CompleteResult",
      "type": "object"
    },
    "Emotion": {
      "enum": [
        "joy",
        "trust",
        "fear",
        "surprise",
        "sadness",
        "disgust",
        "anger",
        "anticipation"
      ],
      "title": "Emotion",
      "type": "string"
    },
    "EmotionReading": {
      "additionalProperties": false,
      "properties": {
        "emotion": {
          "$ref": "#/$defs/Emotion"
        },
        "intensity": {
          "maximum": 10,
          "minimum": 1,
          "title": "Intensity",
          "type": "integer"
        },
        "explanation": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "emotion",
        "intensity",
        "explanation",
        "evidence"
      ],
      "title": "EmotionReading",
      "type": "object"
    },
    "EmotionalAnalysis": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "summary": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "emotions": {
          "items": {
            "$ref": "#/$defs/EmotionReading"
          },
          "maxItems": 8,
          "title": "Emotions",
          "type": "array"
        },
        "characters": {
          "items": {
            "$ref": "#/$defs/CharacterVoice"
          },
          "maxItems": 8,
          "title": "Characters",
          "type": "array"
        },
        "fragments": {
          "items": {
            "$ref": "#/$defs/FragmentCandidate"
          },
          "maxItems": 4,
          "title": "Fragments",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "summary",
        "emotions",
        "characters",
        "fragments"
      ],
      "title": "EmotionalAnalysis",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_message_id": {
          "format": "uuid",
          "title": "Source Message Id",
          "type": "string"
        },
        "quote": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "source_message_id",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FragmentCandidate": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "thought",
            "discovery",
            "possibility"
          ],
          "title": "Kind",
          "type": "string"
        },
        "provenance": {
          "enum": [
            "user_quote",
            "user_paraphrase",
            "ai_hypothesis"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "source_message_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Source Message Ids",
          "type": "array"
        },
        "related_emotions": {
          "items": {
            "$ref": "#/$defs/Emotion"
          },
          "maxItems": 8,
          "title": "Related Emotions",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "provenance",
        "text",
        "source_message_ids",
        "related_emotions"
      ],
      "title": "FragmentCandidate",
      "type": "object"
    },
    "InsufficientResult": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "insufficient_context",
          "title": "Status",
          "type": "string"
        },
        "explanation": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "status",
        "explanation"
      ],
      "title": "InsufficientResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClarificationResult"
        },
        {
          "$ref": "#/$defs/CompleteResult"
        },
        {
          "$ref": "#/$defs/InsufficientResult"
        }
      ],
      "title": "Result"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    }
  },
  "required": [
    "result",
    "request_id"
  ],
  "title": "ExplorationResponse",
  "type": "object"
}
