# JSON array. Explicit origins only; no wildcard credentials.
INNER_WORLD_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Server-only OpenAI credentials. Never use a VITE_* variable.
INNER_WORLD_OPENAI_API_KEY=
# Choose a model available in your account with Responses + Structured Outputs support.
INNER_WORLD_OPENAI_MODEL=
# Per process; resets on restart. One operation can use two provider calls for repair.
INNER_WORLD_AI_REQUESTS_PER_MINUTE=3
INNER_WORLD_AI_REQUESTS_PER_DAY=30

# Single personalization call; local scenes do not call AI. No automatic repair.
INNER_WORLD_ADVENTURE_MAX_OUTPUT_TOKENS=1200
